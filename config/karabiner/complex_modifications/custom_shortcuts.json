{
  "title": "Custom macOS shortcuts",
  "rules": [
    {
      "description": "Swap Option and Command only in Windows App",
      "manipulators": [
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.microsoft\\.rdc\\.macos$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "left_option"
          },
          "to": [
            {
              "key_code": "left_command"
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.microsoft\\.rdc\\.macos$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "left_command"
          },
          "to": [
            {
              "key_code": "left_option"
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.microsoft\\.rdc\\.macos$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "right_option"
          },
          "to": [
            {
              "key_code": "right_command"
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.microsoft\\.rdc\\.macos$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "right_command"
          },
          "to": [
            {
              "key_code": "right_option"
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Finder: Ctrl + LeftClick = Cmd + LeftClick",
      "manipulators": [
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.apple\\.finder$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "modifiers": {
              "mandatory": [
                "left_control"
              ],
              "optional": [
                "any"
              ]
            },
            "pointing_button": "button1"
          },
          "to": [
            {
              "modifiers": [
                "left_command"
              ],
              "pointing_button": "button1"
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Shottr: Ctrl+Cmd+A -> Shift+Cmd+2",
      "manipulators": [
        {
          "from": {
            "key_code": "a",
            "modifiers": {
              "mandatory": [
                "left_control",
                "left_command"
              ]
            }
          },
          "to": [
            {
              "key_code": "2",
              "modifiers": [
                "left_shift",
                "left_command"
              ]
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Option + E to open Finder",
      "manipulators": [
        {
          "from": {
            "key_code": "e",
            "modifiers": {
              "mandatory": [
                "left_option"
              ],
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "shell_command": "open ~"
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Right Shift + Delete to Move to Trash (Cmd + Backspace)",
      "manipulators": [
        {
          "from": {
            "key_code": "delete_or_backspace",
            "modifiers": {
              "mandatory": [
                "right_shift"
              ],
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "delete_or_backspace",
              "modifiers": [
                "left_command"
              ]
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Smart Cmd+T for iTerm2",
      "manipulators": [
        {
          "description": "Change Command+Option+T to Command+T (Original New Tab/Window functionality)",
          "from": {
            "key_code": "t",
            "modifiers": {
              "mandatory": [
                "command",
                "option"
              ]
            }
          },
          "to": [
            {
              "key_code": "t",
              "modifiers": [
                "command"
              ]
            }
          ],
          "type": "basic"
        },
        {
          "description": "Change Command+T to Smart Focus iTerm2",
          "from": {
            "key_code": "t",
            "modifiers": {
              "mandatory": [
                "command"
              ]
            }
          },
          "to": [
            {
              "shell_command": "osascript -e 'tell application \"iTerm\"' -e 'activate' -e 'if (count of windows) = 0 then' -e 'create window with default profile' -e 'else' -e 'tell current window to create tab with default profile' -e 'end if' -e 'end tell'"
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Fine-grained Volume",
      "manipulators": [
        {
          "from": {
            "key_code": "f11",
            "modifiers": {
              "mandatory": [
                "fn"
              ]
            }
          },
          "to": [
            {
              "key_code": "volume_decrement",
              "modifiers": [
                "left_option",
                "left_shift"
              ]
            }
          ],
          "type": "basic"
        },
        {
          "from": {
            "key_code": "f12",
            "modifiers": {
              "mandatory": [
                "fn"
              ]
            }
          },
          "to": [
            {
              "key_code": "volume_increment",
              "modifiers": [
                "left_option",
                "left_shift"
              ]
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Tap Left Shift alone to switch input source",
      "manipulators": [
        {
          "from": {
            "key_code": "left_shift",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 200
          },
          "to": [
            {
              "key_code": "left_shift"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "caps_lock"
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Double tap Left Control to open Spotlight",
      "manipulators": [
        {
          "conditions": [
            {
              "name": "left_control_tapped",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": {
            "key_code": "left_control",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "spacebar",
              "modifiers": [
                "left_command"
              ]
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "left_control_tapped",
                "value": 0
              }
            }
          ],
          "type": "basic"
        },
        {
          "from": {
            "key_code": "left_control",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "left_control_tapped",
                "value": 1
              }
            },
            {
              "key_code": "left_control"
            }
          ],
          "to_delayed_action": {
            "to_if_canceled": [
              {
                "set_variable": {
                  "name": "left_control_tapped",
                  "value": 0
                }
              }
            ],
            "to_if_invoked": [
              {
                "set_variable": {
                  "name": "left_control_tapped",
                  "value": 0
                }
              }
            ]
          },
          "type": "basic"
        }
      ]
    }
  ]
}
